        :root {
            --primary: #1a365d; /* Темно-синий, деловой */
            --accent: #2d5a27; /* Лесной зеленый для акцентов */
            --bg: #f8f9fa;
            --text: #333333;
            --text-light: #666666;
            --white: #ffffff;
        }
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
            line-height: 1.6;
            color: var(--text);
            background-color: var(--bg);
        }
        .container { max-width: 1100px; margin: 0 auto; padding: 0 20px; }
        
        /* Header */
        header {
            background: var(--white);
            border-bottom: 1px solid #e2e8f0;
            padding: 15px 0;
            position: sticky;
            top: 0;
            z-index: 100;
        }
        .header-inner {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        .logo { font-size: 1.5rem; font-weight: 700; color: var(--primary); letter-spacing: -0.5px; }
        .lang-switcher { display: flex; gap: 10px; }
        .lang-btn {
            background: none;
            border: 1px solid #cbd5e1;
            padding: 5px 10px;
            border-radius: 4px;
            cursor: pointer;
            font-size: 0.85rem;
            color: var(--text-light);
            transition: all 0.2s;
        }
        .lang-btn:hover, .lang-btn.active {
            background: var(--primary);
            color: var(--white);
            border-color: var(--primary);
        }

        /* Hero */
        .hero {
            padding: 80px 0 60px;
            text-align: center;
            background: linear-gradient(to bottom, #ffffff, #f1f5f9);
        }
        .hero h1 {
            font-size: 2.5rem;
            color: var(--primary);
            margin-bottom: 20px;
            line-height: 1.2;
        }
        .hero p {
            font-size: 1.2rem;
            color: var(--text-light);
            max-width: 700px;
            margin: 0 auto 30px;
        }

        /* Services */
        .services { padding: 60px 0; }
        .section-title {
            text-align: center;
            font-size: 1.8rem;
            color: var(--primary);
            margin-bottom: 40px;
        }
        .grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 25px;
        }
        .card {
            background: var(--white);
            padding: 30px;
            border-radius: 8px;
            border: 1px solid #e2e8f0;
            transition: transform 0.2s, box-shadow 0.2s;
        }
        .card:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 25px rgba(0,0,0,0.05);
            border-color: var(--accent);
        }
        .card h3 {
            color: var(--primary);
            margin-bottom: 15px;
            font-size: 1.15rem;
        }
        .card p { font-size: 0.95rem; color: var(--text-light); }

        /* For Suppliers */
        .suppliers {
            background: var(--primary);
            color: var(--white);
            padding: 60px 0;
            text-align: center;
        }
        .suppliers h2 { margin-bottom: 20px; font-size: 1.8rem; }
        .suppliers p {
            max-width: 800px;
            margin: 0 auto;
            font-size: 1.1rem;
            opacity: 0.9;
            line-height: 1.7;
        }

        /* Contacts & CTA */
        .contacts { padding: 60px 0 80px; text-align: center; }
        .contact-info {
            margin-bottom: 30px;
            font-size: 1.1rem;
        }
        .contact-info p { margin: 8px 0; }
        .contact-info a {
            color: var(--primary);
            text-decoration: none;
            font-weight: 600;
        }
        .contact-info a:hover { text-decoration: underline; }
        
        .cta-button {
